{
  "name": "@al-kheder/oh-my-mermaid",
  "version": "0.2.0",
  "description": "Architecture mirror for vibe coding — CLI + Claude Code skills",
  "type": "module",
  "bin": {
    "omm": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/",
    "skills/",
    ".claude-plugin/",
    "LICENSE"
  ],
  "homepage": "https://github.com/al-kheder/omm",
  "bugs": {
    "url": "https://github.com/al-kheder/omm/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/al-kheder/omm.git"
  },
  "keywords": [
    "mermaid",
    "architecture",
    "diagram",
    "claude-code",
    "vibe-coding"
  ],
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@10.34.6",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepare": "tsup",
    "check-version-sync": "node scripts/check-version-sync.js",
    "sync-version": "node scripts/sync-version.js",
    "prepublishOnly": "tsup && node scripts/sync-version.js"
  },
  "author": "al-kheder",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^25.5.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  },
  "dependencies": {
    "dagre": "0.8.5",
    "dompurify": "3.1.6",
    "marked": "12.0.2",
    "yaml": "^2.8.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
